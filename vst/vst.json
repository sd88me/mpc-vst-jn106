{
  "name": "JN-106",
  "vendor": "sd88me",
  "uid": "J106",
  "version": 1100,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "so": "kr106.so",
  "params": "params.json",
  "build": {
    "root": "..",
    "sources": [
      "vst/engine.cpp"
    ],
    "cflags": [
      "-std=gnu++17",
      "-Isrc",
      "-O3",
      "-ffast-math",
      "-fno-finite-math-only",
      "-DKR106_SKIP_IDLE_VOICES"
    ],
    "libs": [
      "-lm"
    ],
    "cflags_arm": [
      "-mfpu=neon",
      "-mfloat-abi=hard"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "presets": "presets.json",
  "skin_post": "skin_post.py",
  "defines": {
    "HAS_SONG_POS": 1
  }
}